{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baishanyue/waypoint/schemas/plan.schema.json",
  "title": "Waypoint plan",
  "description": "A validated plan document. The Python validator enforces the same shape and additionally checks that every $step.field reference resolves.",
  "type": "object",
  "required": ["steps"],
  "properties": {
    "goal": {
      "type": "string",
      "description": "Natural-language goal; exposed to steps as $goal.topic."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "action": { "type": "string", "description": "Registered tool name." },
          "inputs": { "type": "object" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "retries": { "type": "integer", "minimum": 0, "default": 0 },
          "kind": { "type": "string", "default": "tool" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
